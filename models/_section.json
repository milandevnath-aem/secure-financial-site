{
  "definitions": [
    {
      "title": "Section",
      "id": "section",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/section/v1/section",
            "template": {
              "name": "Section",
              "model": "section",
              "style": "default",
              "filter": "section"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "section",
      "fields": [
        {
          "component": "tab",
          "label": "Basic",
          "name": "basic"
        },
        {
          "component": "text",
          "name": "name",
          "label": "Section Name",
          "description": "The label shown for this section in the Content Tree"
        },
        {
          "component": "boolean",
          "name": "hide-in-mobile",
          "label": "Don't show in mobile",
          "value": "false",
          "valueType": "boolean"
        },
        {
          "component": "boolean",
          "name": "hide-in-desktop",
          "label": "Don't show in desktop",
          "value": "false",
          "valueType": "boolean"
        },
        {
          "component": "select",
          "name": "sec-spacing",
          "value": "",
          "label": "Spacing Top (padding top)",
          "description": "Section top spacing, default is 32px.",
          "valueType": "string",
          "options": [
            { "name": "Default spacing", "value": "sec-spacing-default" },
            { "name": "No space / padding", "value": "section-none" },
            { "name": "Spacing tiny", "value": "section-tiny" },
            { "name": "Spacing xxsmall", "value": "section-xxsmall" },
            { "name": "Spacing xsmall", "value": "section-xsmall" },
            { "name": "Spacing regular", "value": "section-regular" },
            { "name": "Spacing small", "value": "section-small" },
            { "name": "Spacing medium", "value": "section-medium" },
            { "name": "Spacing large", "value": "section-large" },
            { "name": "Spacing xlarge", "value": "section-xlarge" },
            { "name": "Spacing xxlarge", "value": "section-xxlarge" },
            { "name": "Spacing huge", "value": "section-huge" },
            { "name": "Spacing xhuge", "value": "section-xhuge" }
          ]
        },
        {
          "component": "select",
          "name": "sec-spacing-bottom",
          "value": "",
          "label": "Spacing Bottom (padding bottom)",
          "description": "Section bottom spacing, default is 32px.",
          "valueType": "string",
          "options": [
            { "name": "Default spacing", "value": "sec-spacing-default" },
            { "name": "No space / padding", "value": "section-none" },
            { "name": "Spacing tiny", "value": "section-tiny" },
            { "name": "Spacing xxsmall", "value": "section-xxsmall" },
            { "name": "Spacing xsmall", "value": "section-xsmall" },
            { "name": "Spacing regular", "value": "section-regular" },
            { "name": "Spacing small", "value": "section-small" },
            { "name": "Spacing medium", "value": "section-medium" },
            { "name": "Spacing large", "value": "section-large" },
            { "name": "Spacing xlarge", "value": "section-xlarge" },
            { "name": "Spacing xxlarge", "value": "section-xxlarge" },
            { "name": "Spacing huge", "value": "section-huge" },
            { "name": "Spacing xhuge", "value": "section-xhuge" }
          ]
        },
        {
          "component": "select",
          "name": "sec-swoosh",
          "value": "",
          "label": "Swoosh",
          "valueType": "string",
          "options": [
            { "name": "No Swoosh", "value": "sec-swoosh-none" },
            { "name": "Left Center Swoosh", "value": "sec-swoosh-type1" },
            { "name": "Left Top Swoosh", "value": "sec-swoosh-type3" },
            { "name": "Right Top Swoosh", "value": "sec-swoosh-type2" },
            { "name": "Swoosh for BG inside container - Desktop", "value": "sec-swoosh-type5" },
            { "name": "Leaders profile swoosh", "value": "sec-swoosh-type6" },
            { "name": "Primary Blue 90 theme Swoosh", "value": "sec-swoosh-primary-blue-90" }
          ]
        },
        {
          "component": "select",
          "name": "style",
          "value": "",
          "label": "Background style",
          "valueType": "string",
          "options": [
            { "name": "Transparent / White / Default", "value": "bg-default" },
            { "name": "Dark Background Container", "value": "bg-primary-blue" },
            { "name": "Primary Blue 90", "value": "bg-primary-blue-90" },
            { "name": "Primary Blue 70", "value": "bg-primary-blue-70" },
            { "name": "Neutrals 10", "value": "bg-neutrals-10" },
            { "name": "Neutrals 20", "value": "bg-neutrals-20" },
            { "name": "Background Image", "value": "bg-image" }
          ]
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Background Image",
          "description": "Optional background image for this section. For tablet/mobile variants, set Background style to \"Background Image\" and use the options below.",
          "multi": false
        },
        {
          "component": "container",
          "label": "Background Image (tablet/mobile)",
          "name": "container",
          "valueType": "string",
          "collapsible": true,
          "condition": {
            "==": [{ "var": "style" }, "bg-image"]
          },
          "fields": [
            {
              "component": "reference",
              "valueType": "string",
              "name": "tab-image",
              "label": "Tablet Image",
              "description": "Background image will be used on tablet by default.",
              "multi": false
            },
            {
              "component": "reference",
              "valueType": "string",
              "name": "mob-image",
              "label": "Mobile Image",
              "description": "Background / Tablet image will be used on mobile by default.",
              "multi": false
            }
          ]
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "sec-inside-container",
          "label": "Show background color inside container.",
          "condition": {
            "!=": [{ "var": "style" }, "bg-image"]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "sec-width",
          "label": "Reduce section width.",
          "condition": {
            "!=": [{ "var": "style" }, "bg-image"]
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "sec-color",
          "value": "",
          "label": "Section text color",
          "description": "Hex color for section text (e.g. #fff, #000000, or 333). Leave empty for default."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "sec-custom-styles",
          "value": "",
          "label": "Custom class",
          "description": "Additional CSS class name(s) for this section (space-separated for multiple). Same as hero Custom Styles."
        },
        {
          "component": "select",
          "name": "sec-alignment",
          "value": "",
          "label": "Text Alignment",
          "valueType": "string",
          "options": [
            { "name": "Left", "value": "left" },
            { "name": "Center", "value": "center" },
            { "name": "Right", "value": "right" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "sec-item-widths",
          "value": "",
          "label": "Item widths (%)",
          "description": "Comma-separated width percentages for items (e.g. 25,25,50). When set, items are arranged horizontally with these widths."
        },
        {
          "component": "tab",
          "label": "Mobile Specific",
          "name": "mobileSpecific"
        },
        {
          "component": "text",
          "name": "custommobilestyle",
          "label": "Custom Mobile Style",
          "valueType": "string[]",
          "multi": true,
          "description": "One style per row, as key:value (e.g. width:250, padding:0)"
        }
      ]
    }
  ],
